{
  "name": "black-diamond-brawl",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "verify:palette": "node --import tsx scripts/verifyPalette.ts",
    "verify:combat": "node --import tsx scripts/verifyCombat.ts",
    "verify:solvability": "node --import tsx scripts/verifySolvability.ts",
    "verify:visual": "node scripts/smokeTest.mjs",
    "measure:rocklock": "node --import tsx scripts/measureRockLock.ts",
    "lab": "node scripts/spriteLab.mjs",
    "verify:controls": "node --import tsx scripts/verifyControls.ts",
    "verify:scoring": "node --import tsx scripts/verifyScoring.ts",
    "verify:rendering": "node --import tsx scripts/verifyRendering.ts",
    "verify:art": "node --import tsx scripts/verifyArt.ts",
    "verify:pacing": "node --import tsx scripts/verifyPacing.ts",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "verify:mobile": "node scripts/mobileAcceptance.mjs",
    "verify:native-config": "node scripts/verifyNativeConfig.mjs",
    "verify:ios": "bash scripts/verify-ios.sh",
    "verify:models": "node scripts/verify.mjs --models-only",
    "verify:expansion": "node scripts/expansionAcceptance.mjs",
    "verify:menus": "node scripts/verifyMenus.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "^20.0.0",
    "playwright": "^1.49.0",
    "tsx": "^4.23.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
