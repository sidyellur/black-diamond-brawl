{
  "name": "black-diamond-brawl",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "verify:palette": "node --import tsx scripts/verifyPalette.ts",
    "verify:combat": "node --import tsx scripts/verifyCombat.ts",
    "verify:solvability": "node --import tsx scripts/verifySolvability.ts",
    "verify:visual": "node scripts/smokeTest.mjs",
    "measure:rocklock": "node --import tsx scripts/measureRockLock.ts",
    "lab": "node scripts/spriteLab.mjs",
    "verify:controls": "node --import tsx scripts/verifyControls.ts",
    "verify:scoring": "node --import tsx scripts/verifyScoring.ts",
    "verify:rendering": "node --import tsx scripts/verifyRendering.ts",
    "verify:art": "node --import tsx scripts/verifyArt.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "playwright": "^1.49.0",
    "tsx": "^4.23.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
